FROM node:22-alpine AS frontend
WORKDIR /src
RUN npm install -g pnpm@11.22.0
COPY core/frontend/package.json core/frontend/pnpm-lock.yaml core/frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY core/frontend/ ./
RUN pnpm build

FROM golang:1.23.2-alpine AS backend
WORKDIR /src
COPY core/go.mod core/go.sum ./
RUN go mod download
COPY core/ ./
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -mod=readonly -trimpath -ldflags="-s -w" -o /billionmail main.go

FROM billionmail/core:4.9.1
COPY --from=backend /billionmail /opt/billionmail/core/billionmail
COPY core/manifest/ /opt/billionmail/core/manifest/
COPY --from=frontend /src/dist/ /opt/billionmail/core/public/dist/
