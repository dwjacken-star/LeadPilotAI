# Current Aliyun deployment: self-hosted SMTP + local IMAP/Webmail.
# Existing .env database/Redis credentials must be retained.
BILLIONMAIL_HOSTNAME=mail.best-maple.com
PUBLIC_BASE_URL=https://mail.best-maple.com
MAPLEMAIL_SMTP_HOSTNAME=mail.best-maple.com
# From / Reply-To are configured in administrator Settings > Common parameters.
# DNS: best-maple.com MX -> mail.best-maple.com; mail A -> 47.237.67.184
# The local sales mailbox is required. Never reset an existing mailbox password.
