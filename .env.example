# Configuration template only. Copy to .env and supply private values locally.
# Never commit the populated .env file or reuse test passwords in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SafePath=
BILLIONMAIL_HOSTNAME=mail.example.com
PUBLIC_BASE_URL=https://mail.example.com
DBNAME=billionmail
DBUSER=billionmail
DBPASS=
REDISPASS=
TZ=Etc/UTC
HTTP_PORT=80
HTTPS_PORT=443
SQL_PORT=127.0.0.1:25432
REDIS_PORT=127.0.0.1:26379

# Optional backend fallback for create/batch/import requests without a password.
# Supply a private password of at least 8 characters or leave empty to disable.
# The mailbox UI requires an explicit password and never exposes this value.
DEFAULT_NEW_MAILBOX_PASSWORD=
